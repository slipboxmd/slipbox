{
  "name": "pi-slipbox",
  "version": "0.0.0",
  "description": "A Pi.dev harness for building and maintaining a Zettelkasten slipbox from any source — chunk, embed, cluster, and grow flat-markdown notes.",
  "type": "module",
  "license": "MIT",
  "author": "Zachary Fleischmann",
  "keywords": [
    "pi",
    "pi-agent",
    "zettelkasten",
    "slipbox",
    "notes",
    "knowledge-management",
    "embeddings",
    "rag"
  ],
  "files": [
    "src",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^5.6.0"
  }
}
