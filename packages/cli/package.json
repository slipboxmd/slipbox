{
  "name": "@slipbox/cli",
  "version": "0.1.1",
  "description": "Slipbox — a Zettelkasten harness for Pi. Build and grow a flat-markdown slipbox from any source.",
  "type": "module",
  "license": "MIT",
  "author": "Zachary Fleischmann",
  "keywords": [
    "pi",
    "zettelkasten",
    "slipbox",
    "notes",
    "cli",
    "agent"
  ],
  "homepage": "https://slipbox.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slipboxmd/slipbox.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/slipboxmd/slipbox/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "slipbox": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@slipbox/core": "workspace:^",
    "@earendil-works/pi-coding-agent": "^0.81.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@slipbox/web": "workspace:*"
  }
}
