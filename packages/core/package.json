{
  "name": "@slipbox/core",
  "version": "0.0.0",
  "description": "Core Slipbox harness for Pi — ingest any source into a flat-markdown Zettelkasten (chunk, embed, cluster, note).",
  "type": "module",
  "license": "MIT",
  "author": "Zachary Fleischmann",
  "keywords": [
    "pi",
    "pi-agent",
    "zettelkasten",
    "slipbox",
    "notes",
    "knowledge-management",
    "embeddings",
    "qmd"
  ],
  "files": [
    "src",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
