{
  "name": "@slipbox/core",
  "version": "0.0.0",
  "description": "Core Slipbox harness for Pi \u2014 ingest any source into a flat-markdown Zettelkasten (chunk, embed, cluster, note).",
  "type": "module",
  "license": "MIT",
  "author": "Zachary Fleischmann",
  "keywords": [
    "pi",
    "pi-agent",
    "zettelkasten",
    "slipbox",
    "notes",
    "knowledge-management",
    "embeddings",
    "qmd"
  ],
  "homepage": "https://slipbox.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slipboxmd/slipbox.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/slipboxmd/slipbox/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/qmd/vectors.mjs dist/qmd/vectors.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.7-alpha.2",
    "yaml": "^2.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@slipbox/web": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "^1.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@slipbox/web": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@slipbox/web": {
      "optional": true
    }
  }
}
